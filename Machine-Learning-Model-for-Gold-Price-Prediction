        "\n",
        "    return X_train, y_train, X_val, y_val, X_test, y_test\n",
        "\n",
        "\n",
        "def make_sequences(frame, x_cols, y_cols, lookback):\n",
        "    X_seq, y_seq = [], []\n",
        "\n",
        "    x_data = frame[x_cols].values\n",
        "    y_data = frame[y_cols].values\n",
        "\n",
        "    for i in range(lookback, len(frame)):\n",
        "        X_seq.append(x_data[i - lookback:i])\n",
        "        y_seq.append(y_data[i])\n",
        "\n",
        "    return np.array(X_seq), np.array(y_seq)\n",
        "\n",
        "\n",
        "def make_sequence_arrays(train_scaled, val_scaled, test_scaled, x_cols, y_cols, lookback):\n",
        "    X_train, y_train = make_sequences(train_scaled, x_cols, y_cols, lookback)\n",
        "    X_val, y_val = make_sequences(val_scaled, x_cols, y_cols, lookback)\n",
        "    X_test, y_test = make_sequences(test_scaled, x_cols, y_cols, lookback)\n",
        "\n",
        "    return X_train, y_train, X_val, y_val, X_test, y_test\n",
        "\n",
        "# -----------------------------------\n",
        "# Models\n",
        "# -----------------------------------\n",
        "class MLPJoint(nn.Module):\n",
        "    def __init__(self, input_dim, hidden_dims=(128, 64), dropout=0.2):\n",
        "        super().__init__()\n",
        "\n",
        "        layers = []\n",
        "        prev_dim = input_dim\n",
        "\n",
        "        for h in hidden_dims:\n",
        "            layers.append(nn.Linear(prev_dim, h))\n",
        "            layers.append(nn.ReLU())\n",
        "            layers.append(nn.Dropout(dropout))\n",
        "            prev_dim = h\n",
        "\n",
        "        self.backbone = nn.Sequential(*layers)\n",
        "        self.out = nn.Linear(prev_dim, 2)\n",
        "\n",
        "    def forward(self, x):\n",
        "        z = self.backbone(x)\n",
        "        return self.out(z)\n",
        "\n",
        "\n",
        "class LSTMJoint(nn.Module):\n",
        "    def __init__(self, input_dim, hidden_dim=64, num_layers=1, dropout=0.2):\n",
        "        super().__init__()\n",
        "\n",
        "        lstm_dropout = dropout if num_layers > 1 else 0.0\n",
        "\n",
        "        self.lstm = nn.LSTM(\n",
        "            input_size=input_dim,\n",
        "            hidden_size=hidden_dim,\n",
        "            num_layers=num_layers,\n",
        "            batch_first=True,\n",
        "            dropout=lstm_dropout\n",
        "        )\n",
        "\n",
        "        self.head = nn.Sequential(\n",
        "            nn.Linear(hidden_dim, hidden_dim),\n",
        "            nn.ReLU(),\n",
        "            nn.Dropout(dropout),\n",
        "            nn.Linear(hidden_dim, 2)\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        out, _ = self.lstm(x)\n",
        "        last_hidden = out[:, -1, :]\n",
        "        return self.head(last_hidden)\n",
        "\n",
        "\n",
        "class PositionalEncoding(nn.Module):\n",
        "    def __init__(self, d_model, max_len=256):\n",
        "        super().__init__()\n",
        "\n",
        "        pe = torch.zeros(max_len, d_model)\n",
        "        positions = torch.arange(0, max_len, dtype=torch.float32).unsqueeze(1)\n",
        "        div_term = torch.exp(\n",
        "            torch.arange(0, d_model, 2, dtype=torch.float32) * (-math.log(10000.0) / d_model)\n",
        "        )\n",
        "\n",
        "        pe[:, 0::2] = torch.sin(positions * div_term)\n",
        "        pe[:, 1::2] = torch.cos(positions * div_term)\n",
        "        pe = pe.unsqueeze(0)\n",
        "\n",
        "        self.register_buffer(\"pe\", pe)\n",
        "\n",
        "    def forward(self, x):\n",
        "        seq_len = x.size(1)\n",
        "        return x + self.pe[:, :seq_len]\n",
        "\n",
        "\n",
        "class TransformerJoint(nn.Module):\n",
        "    def __init__(self, input_dim, d_model=64, nhead=4, num_layers=2, dropout=0.2):\n",
        "        super().__init__()\n",
        "\n",
        "        self.input_proj = nn.Linear(input_dim, d_model)\n",
        "        self.pos_enc = PositionalEncoding(d_model=d_model, max_len=256)\n",
        "\n",
        "        encoder_layer = nn.TransformerEncoderLayer(\n",
        "            d_model=d_model,\n",
        "            nhead=nhead,\n",
        "            dim_feedforward=d_model * 2,\n",
        "            dropout=dropout,\n",
        "            batch_first=True,\n",
        "            activation=\"gelu\"\n",
        "        )\n",
        "\n",
        "        self.encoder = nn.TransformerEncoder(encoder_layer, num_layers=num_layers)\n",
        "\n",
        "        self.head = nn.Sequential(\n",
        "            nn.Linear(d_model, d_model),\n",
        "            nn.ReLU(),\n",
        "            nn.Dropout(dropout),\n",
        "            nn.Linear(d_model, 2)\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        z = self.input_proj(x)\n",
        "        z = self.pos_enc(z)\n",
        "        z = self.encoder(z)\n",
        "        pooled = z[:, -1, :]\n",
        "        return self.head(pooled)\n",
        "\n",
        "# -----------------------------------\n",
        "# Early stopping\n",
        "# -----------------------------------\n",
        "class EarlyStopper:\n",
        "    def __init__(self, patience=10, min_delta=0.0):\n",
        "        self.patience = patience\n",
        "        self.min_delta = min_delta\n",
        "        self.best_loss = None\n",
        "        self.wait = 0\n",
        "        self.best_state = None\n",
        "\n",
        "    def step(self, val_loss, model):\n",
        "        if self.best_loss is None or val_loss < self.best_loss - self.min_delta:\n",
        "            self.best_loss = val_loss\n",
        "            self.wait = 0\n",
        "            self.best_state = copy.deepcopy(model.state_dict())\n",
        "            return False\n",
        "\n",
        "        self.wait += 1\n",
        "        return self.wait >= self.patience\n",
        "\n",
        "# -----------------------------------\n",
        "# Metrics on the original scale\n",
        "# -----------------------------------\n",
        "def regression_metrics(y_true_original, y_pred_original):\n",
        "    out = {}\n",
        "\n",
        "    true_r = y_true_original[:, 0]\n",
        "    pred_r = y_pred_original[:, 0]\n",
        "\n",
        "    true_v = y_true_original[:, 1]\n",
        "    pred_v = y_pred_original[:, 1]\n",
        "\n",
        "    out[\"rmse_return\"] = float(np.sqrt(np.mean((pred_r - true_r) ** 2)))\n",
        "    out[\"mae_return\"] = float(np.mean(np.abs(pred_r - true_r)))\n",
        "    out[\"dir_acc\"] = float(np.mean(np.sign(pred_r) == np.sign(true_r)))\n",
        "\n",
        "    out[\"rmse_vol\"] = float(np.sqrt(np.mean((pred_v - true_v) ** 2)))\n",
        "    out[\"mae_vol\"] = float(np.mean(np.abs(pred_v - true_v)))\n",
        "\n",
        "    if np.std(pred_v) == 0 or np.std(true_v) == 0:\n",
        "        out[\"vol_corr\"] = np.nan\n",
        "    else:\n",
        "        out[\"vol_corr\"] = float(np.corrcoef(pred_v, true_v)[0, 1])\n",
        "\n",
        "    return out\n",
        "\n",
        "# -----------------------------------\n",
        "# Training loop\n",
        "# -----------------------------------\n",
        "def run_training(model, train_loader, val_loader, lr=1e-3, weight_decay=1e-4,\n",
        "                 max_epochs=80, patience=10, clip_norm=1.0):\n",
        "    model = model.to(device)\n",
        "\n",
        "    optimizer = torch.optim.AdamW(model.parameters(), lr=lr, weight_decay=weight_decay)\n",
        "    criterion = nn.HuberLoss()\n",
        "\n",
        "    stopper = EarlyStopper(patience=patience, min_delta=0.0)\n",
        "\n",
        "    history = {\n",
        "        \"train_loss\": [],\n",
        "        \"val_loss\": []\n",
        "    }\n",
        "\n",
        "    for epoch in range(max_epochs):\n",
        "        model.train()\n",
        "        train_losses = []\n",
        "\n",
        "        for xb, yb in train_loader:\n",
        "            xb = xb.to(device)\n",
        "            yb = yb.to(device)\n",
        "\n",
        "            optimizer.zero_grad()\n",
        "            pred = model(xb)\n",
        "\n",
        "            loss_return = criterion(pred[:, 0], yb[:, 0])\n",
        "            loss_vol = criterion(pred[:, 1], yb[:, 1])\n",
        "            loss = 0.5 * (loss_return + loss_vol)\n",
        "\n",
        "            loss.backward()\n",
        "            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=clip_norm)\n",
        "            optimizer.step()\n",
        "\n",
        "            train_losses.append(loss.item())\n",
        "\n",
        "        model.eval()\n",
        "        val_losses = []\n",
        "\n",
        "        with torch.no_grad():\n",
        "            for xb, yb in val_loader:\n",
        "                xb = xb.to(device)\n",
        "                yb = yb.to(device)\n",
        "\n",
        "                pred = model(xb)\n",
        "\n",
        "                loss_return = criterion(pred[:, 0], yb[:, 0])\n",
        "                loss_vol = criterion(pred[:, 1], yb[:, 1])\n",
        "                loss = 0.5 * (loss_return + loss_vol)\n",
        "\n",
        "                val_losses.append(loss.item())\n",
        "\n",
        "        train_loss = float(np.mean(train_losses))\n",
        "        val_loss = float(np.mean(val_losses))\n",
        "\n",
        "        history[\"train_loss\"].append(train_loss)\n",
        "        history[\"val_loss\"].append(val_loss)\n",
        "\n",
        "        stop = stopper.step(val_loss, model)\n",
        "        if stop:\n",
        "            break\n",
        "\n",
        "    model.load_state_dict(stopper.best_state)\n",
        "    return model, history, stopper.best_loss\n",
        "\n",
        "# -----------------------------------\n",
        "# Prediction helper\n",
        "# -----------------------------------\n",
        "def predict_model(model, loader):\n",
        "    model.eval()\n",
        "\n",
        "    preds = []\n",
        "    truths = []\n",
        "\n",
        "    with torch.no_grad():\n",
        "        for xb, yb in loader:\n",
        "            xb = xb.to(device)\n",
        "            pred = model(xb).cpu().numpy()\n",
        "\n",
        "            preds.append(pred)\n",
        "            truths.append(yb.numpy())\n",
        "\n",
        "    preds = np.vstack(preds)\n",
        "    truths = np.vstack(truths)\n",
        "\n",
        "    return preds, truths\n",
        "\n",
        "# -----------------------------------\n",
        "# Plot helper\n",
        "# -----------------------------------\n",
        "def plot_loss_history(history, title):\n",
        "    plt.figure(figsize=(8, 4))\n",
        "    plt.plot(history[\"train_loss\"], label=\"Train\")\n",
        "    plt.plot(history[\"val_loss\"], label=\"Validation\")\n",
        "    plt.title(title)\n",
        "    plt.xlabel(\"Epoch\")\n",
        "    plt.ylabel(\"Huber loss\")\n",
        "    plt.legend()\n",
        "    plt.grid(True)\n",
        "    plt.show()\n",
        "\n",
        "# -----------------------------------\n",
        "# Search runners\n",
        "# -----------------------------------\n",
        "def run_mlp_search(configs, batch_size_default=64):\n",
        "    X_train, y_train, X_val, y_val, X_test, y_test = make_mlp_arrays(\n",
        "        train_scaled, val_scaled, test_scaled, x_scaled_cols, y_scaled_cols\n",
        "    )\n",
        "\n",
        "    results = []\n",
        "    best_bundle = None\n",
        "    best_val = np.inf\n",
        "\n",
        "    for cfg in configs:\n",
        "        batch_size = cfg.get(\"batch_size\", batch_size_default)\n",
        "\n",
        "        train_ds = TensorDataset2D(X_train, y_train)\n",
        "        val_ds = TensorDataset2D(X_val, y_val)\n",
        "        test_ds = TensorDataset2D(X_test, y_test)\n",
        "\n",
        "        train_loader = DataLoader(train_ds, batch_size=batch_size, shuffle=True)\n",
        "        val_loader = DataLoader(val_ds, batch_size=batch_size, shuffle=False)\n",
        "        test_loader = DataLoader(test_ds, batch_size=batch_size, shuffle=False)\n",
        "\n",
        "        model = MLPJoint(\n",
        "            input_dim=X_train.shape[1],\n",
        "            hidden_dims=cfg[\"hidden_dims\"],\n",
        "            dropout=cfg[\"dropout\"]\n",
        "        )\n",
        "\n",
        "        model, history, best_loss = run_training(\n",
        "            model=model,\n",
        "            train_loader=train_loader,\n",
        "            val_loader=val_loader,\n",
        "            lr=cfg[\"lr\"],\n",
        "            weight_decay=cfg[\"weight_decay\"],\n",
        "            max_epochs=cfg[\"max_epochs\"],\n",
        "            patience=cfg[\"patience\"],\n",
        "            clip_norm=cfg[\"clip_norm\"]\n",
        "        )\n",
        "\n",
        "        pred_val_scaled, true_val_scaled = predict_model(model, val_loader)\n",
        "        pred_test_scaled, true_test_scaled = predict_model(model, test_loader)\n",
        "\n",
        "        pred_val = y_scaler.inverse_transform(pred_val_scaled)\n",
        "        true_val = y_scaler.inverse_transform(true_val_scaled)\n",
        "\n",
        "        pred_test = y_scaler.inverse_transform(pred_test_scaled)\n",
        "        true_test = y_scaler.inverse_transform(true_test_scaled)\n",
        "\n",
        "        val_metrics = regression_metrics(true_val, pred_val)\n",
        "        test_metrics = regression_metrics(true_test, pred_test)\n",
        "\n",
        "        row = {\n",
        "            \"model_type\": \"mlp\",\n",
        "            \"config\": cfg,\n",
        "            \"best_val_loss\": best_loss,\n",
        "            **{f\"val_{k}\": v for k, v in val_metrics.items()},\n",
        "            **{f\"test_{k}\": v for k, v in test_metrics.items()},\n",
        "        }\n",
        "        results.append(row)\n",
        "\n",
        "        if best_loss < best_val:\n",
        "            best_val = best_loss\n",
        "            best_bundle = {\n",
        "                \"model\": model,\n",
        "                \"history\": history,\n",
        "                \"config\": cfg,\n",
        "                \"val_metrics\": val_metrics,\n",
        "                \"test_metrics\": test_metrics\n",
        "            }\n",
        "\n",
        "    return pd.DataFrame(results), best_bundle\n",
        "\n",
        "\n",
        "def run_sequence_search(model_type, configs, batch_size_default=64):\n",
        "    results = []\n",
        "    best_bundle = None\n",
        "    best_val = np.inf\n",
        "\n",
        "    for cfg in configs:\n",
        "        batch_size = cfg.get(\"batch_size\", batch_size_default)\n",
        "        lookback = cfg[\"lookback\"]\n",
        "\n",
        "        X_train, y_train, X_val, y_val, X_test, y_test = make_sequence_arrays(\n",
        "            train_scaled, val_scaled, test_scaled,\n",
        "            x_scaled_cols, y_scaled_cols,\n",
        "            lookback=lookback\n",
        "        )\n",
        "\n",
        "        train_ds = TensorDataset3D(X_train, y_train)\n",
        "        val_ds = TensorDataset3D(X_val, y_val)\n",
        "        test_ds = TensorDataset3D(X_test, y_test)\n",
        "\n",
        "        train_loader = DataLoader(train_ds, batch_size=batch_size, shuffle=True)\n",
        "        val_loader = DataLoader(val_ds, batch_size=batch_size, shuffle=False)\n",
        "        test_loader = DataLoader(test_ds, batch_size=batch_size, shuffle=False)\n",
        "\n",
        "        if model_type == \"lstm\":\n",
        "            model = LSTMJoint(\n",
        "                input_dim=X_train.shape[2],\n",
        "                hidden_dim=cfg[\"hidden_dim\"],\n",
        "                num_layers=cfg[\"num_layers\"],\n",
        "                dropout=cfg[\"dropout\"]\n",
        "            )\n",
        "        elif model_type == \"transformer\":\n",
        "            model = TransformerJoint(\n",
        "                input_dim=X_train.shape[2],\n",
        "                d_model=cfg[\"d_model\"],\n",
        "                nhead=cfg[\"nhead\"],\n",
        "                num_layers=cfg[\"num_layers\"],\n",
        "                dropout=cfg[\"dropout\"]\n",
        "            )\n",
        "        else:\n",
        "            raise ValueError(\"model_type must be 'lstm' or 'transformer'\")\n",
        "\n",
        "        model, history, best_loss = run_training(\n",
        "            model=model,\n",
        "            train_loader=train_loader,\n",
        "            val_loader=val_loader,\n",
        "            lr=cfg[\"lr\"],\n",
        "            weight_decay=cfg[\"weight_decay\"],\n",
        "            max_epochs=cfg[\"max_epochs\"],\n",
        "            patience=cfg[\"patience\"],\n",
        "            clip_norm=cfg[\"clip_norm\"]\n",
        "        )\n",
        "\n",
        "        pred_val_scaled, true_val_scaled = predict_model(model, val_loader)\n",
        "        pred_test_scaled, true_test_scaled = predict_model(model, test_loader)\n",
        "\n",
        "        pred_val = y_scaler.inverse_transform(pred_val_scaled)\n",
        "        true_val = y_scaler.inverse_transform(true_val_scaled)\n",
        "\n",
        "        pred_test = y_scaler.inverse_transform(pred_test_scaled)\n",
        "        true_test = y_scaler.inverse_transform(true_test_scaled)\n",
        "\n",
        "        val_metrics = regression_metrics(true_val, pred_val)\n",
        "        test_metrics = regression_metrics(true_test, pred_test)\n",
        "\n",
        "        row = {\n",
        "            \"model_type\": model_type,\n",
        "            \"config\": cfg,\n",
        "            \"best_val_loss\": best_loss,\n",
        "            **{f\"val_{k}\": v for k, v in val_metrics.items()},\n",
        "            **{f\"test_{k}\": v for k, v in test_metrics.items()},\n",
        "        }\n",
        "        results.append(row)\n",
        "\n",
        "        if best_loss < best_val:\n",
        "            best_val = best_loss\n",
        "            best_bundle = {\n",
        "                \"model\": model,\n",
        "                \"history\": history,\n",
        "                \"config\": cfg,\n",
        "                \"val_metrics\": val_metrics,\n",
        "                \"test_metrics\": test_metrics\n",
        "            }\n",
        "\n",
        "    return pd.DataFrame(results), best_bundle\n",
        "\n",
