        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "plt.rcParams[\"figure.figsize\"] = (12, 5)\n",
        "plt.rcParams[\"axes.grid\"] = True\n",
        "\n",
        "# Read the file\n",
        "df = pd.read_csv(\"finalgolddata.csv\")\n",
        "\n",
        "# Turn the date column into datetime and order the rows\n",
        "df[\"Date\"] = pd.to_datetime(df[\"Date\"], format=\"%d-%m-%y\")\n",
        "df = df.sort_values(\"Date\").reset_index(drop=True)\n",
        "\n",
        "# Basic checks\n",
        "missing_counts = df.isna().sum()\n",
        "duplicate_rows = df.duplicated().sum()\n",
        "zero_volume_rows = (df[\"Volume\"] == 0).sum()\n",
        "\n",
        "# Check whether OHLC values make sense row by row\n",
        "# Low should not be above the other price fields\n",
        "# High should not be below the other price fields\n",
        "df[\"ohlc_ok\"] = (\n",
        "    (df[\"Low\"] <= df[[\"Open\", \"High\", \"Close\"]].min(axis=1)) &\n",
        "    (df[\"High\"] >= df[[\"Open\", \"Low\", \"Close\"]].max(axis=1))\n",
        ")\n",
        "\n",
        "bad_ohlc_rows = (~df[\"ohlc_ok\"]).sum()\n",
        "\n",
        "print(\"Rows:\", len(df))\n",
        "print(\"Start date:\", df[\"Date\"].min().date())\n",
        "print(\"End date:\", df[\"Date\"].max().date())\n",
        "print(\"\\nMissing values by column:\")\n",
        "print(missing_counts)\n",
        "print(\"\\nDuplicate rows:\", duplicate_rows)\n",
        "print(\"Rows with zero volume:\", zero_volume_rows)\n",
        "print(\"Share with zero volume: {:.2f}%\".format(100 * zero_volume_rows / len(df)))\n",
        "print(\"Rows failing the OHLC check:\", bad_ohlc_rows)\n",
        "print(\"Share failing the OHLC check: {:.2f}%\".format(100 * bad_ohlc_rows / len(df)))\n",
        "\n",
        "# Build a few columns for inspection\n",
        "df[\"log_return\"] = np.log(df[\"Close\"]).diff()\n",
        "df[\"pct_return\"] = df[\"Close\"].pct_change() * 100\n",
        "df[\"ma_20\"] = df[\"Close\"].rolling(20).mean()\n",
        "df[\"ma_100\"] = df[\"Close\"].rolling(100).mean()\n",
        "df[\"vol_21\"] = df[\"log_return\"].rolling(21).std() * np.sqrt(252)\n",
        "\n",
        "# Intraday range can be misleading on rows where OHLC is inconsistent\n",
        "df[\"range_pct\"] = np.where(\n",
        "    df[\"ohlc_ok\"],\n",
        "    (df[\"High\"] - df[\"Low\"]) / df[\"Close\"] * 100,\n",
        "    np.nan\n",
        ")\n",
        "\n",
        "# Summary table for the numeric columns\n",
        "summary_table = df[[\"Open\", \"High\", \"Low\", \"Close\", \"Volume\"]].describe().T\n",
        "summary_table[\"missing\"] = df[[\"Open\", \"High\", \"Low\", \"Close\", \"Volume\"]].isna().sum()\n",
        "summary_table = summary_table.round(3)\n",
        "\n",
        "print(\"\\nSummary table:\")\n",
        "print(summary_table)\n",
        "\n",
        "# Save a cleaned copy for later work\n",
        "df.to_csv(\"gold_cleaned_eda.csv\", index=False)\n",
        "\n",
        "# -----------------------------\n",
        "# Plot 1: Closing price over time\n",
        "# -----------------------------\n",
        "plt.figure()\n",
        "plt.plot(df[\"Date\"], df[\"Close\"], linewidth=1.2)\n",
        "plt.title(\"Gold Closing Price\")\n",
        "plt.xlabel(\"Date\")\n",
        "plt.ylabel(\"Close\")\n",
        "plt.show()\n",
        "\n",
        "# -----------------------------\n",
        "# Plot 2: Close with moving averages\n",
        "# -----------------------------\n",
        "plt.figure()\n",
        "plt.plot(df[\"Date\"], df[\"Close\"], label=\"Close\", linewidth=1.0)\n",
        "plt.plot(df[\"Date\"], df[\"ma_20\"], label=\"20-day average\", linewidth=1.2)\n",
        "plt.plot(df[\"Date\"], df[\"ma_100\"], label=\"100-day average\", linewidth=1.2)\n",
        "plt.title(\"Gold Close with Moving Averages\")\n",
        "plt.xlabel(\"Date\")\n",
        "plt.ylabel(\"Price\")\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "# -----------------------------\n",
        "# Plot 3: Daily return histogram\n",
        "# -----------------------------\n",
        "plt.figure()\n",
        "plt.hist(df[\"pct_return\"].dropna(), bins=80)\n",
        "plt.title(\"Distribution of Daily Returns\")\n",
        "plt.xlabel(\"Daily return (%)\")\n",
        "plt.ylabel(\"Count\")\n",
        "plt.show()\n",
        "\n",
        "# -----------------------------\n",
        "# Plot 4: 21-day rolling volatility\n",
        "# -----------------------------\n",
        "plt.figure()\n",
        "plt.plot(df[\"Date\"], df[\"vol_21\"], linewidth=1.2)\n",
        "plt.title(\"21-Day Rolling Volatility\")\n",
        "plt.xlabel(\"Date\")\n",
        "plt.ylabel(\"Volatility\")\n",
        "plt.show()\n",
        "\n",
        "# -----------------------------\n",
        "# Plot 5: Volume through time\n",
        "# -----------------------------\n",
        "plt.figure()\n",
        "plt.plot(df[\"Date\"], df[\"Volume\"], linewidth=1.0)\n",
        "plt.title(\"Volume Over Time\")\n",
        "plt.xlabel(\"Date\")\n",
        "plt.ylabel(\"Volume\")\n",
        "plt.show()\n",
        "\n",
        "# -----------------------------\n",
        "# Plot 6: Percentage intraday range\n",
        "# -----------------------------\n",
        "plt.figure()\n",
        "plt.plot(df[\"Date\"], df[\"range_pct\"], linewidth=1.0)\n",
        "plt.title(\"Intraday Range as % of Close\")\n",
        "plt.xlabel(\"Date\")\n",
        "plt.ylabel(\"Range (%)\")\n",
        "plt.show()\n",
        "\n",
        "# -----------------------------\n",
        "# Yearly summary\n",
        "# -----------------------------\n",
        "yearly = (\n",
        "    df.set_index(\"Date\")[\"Close\"]\n",
        "      .resample(\"Y\")\n",
        "      .agg([\"first\", \"last\", \"min\", \"max\", \"mean\"])\n",
        ")\n",
        "\n",
        "yearly[\"year_return_pct\"] = (yearly[\"last\"] / yearly[\"first\"] - 1) * 100\n",
        "yearly.index = yearly.index.year\n",
        "yearly = yearly.round(2)\n",
        "\n",
        "print(\"\\nYearly summary:\")\n",
        "print(yearly.tail(10))\n",
        "\n",
        "# -----------------------------\n",
        "# Monthly average close\n",
        "# -----------------------------\n",
        "monthly_close = df.set_index(\"Date\")[\"Close\"].resample(\"M\").mean()\n",
        "\n",
        "plt.figure()\n",
        "plt.plot(monthly_close.index, monthly_close.values, linewidth=1.1)\n",
        "plt.title(\"Monthly Average Close\")\n",
        "plt.xlabel(\"Date\")\n",
        "plt.ylabel(\"Average close\")\n",
