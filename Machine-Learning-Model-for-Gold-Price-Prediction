        "        zero_volume_rows,\n",
        "        round(100 * zero_volume_rows / len(df), 2),\n",
        "        bad_ohlc_rows,\n",
        "        round(100 * bad_ohlc_rows / len(df), 2)\n",
        "    ]\n",
        "})\n",
        "\n",
        "print(\"\\nMain checks:\")\n",
        "print(checks)"
